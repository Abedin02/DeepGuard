# ──────────────────────────────────────────────────────────────────
# DeepGuard Backend — Environment Variables (Example)
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────

# ── Firebase Admin SDK ────────────────────────────────────────────
# Preferred: paste the Firebase service-account JSON directly.
# FIREBASE_SERVICE_ACCOUNT_INLINE={"type":"service_account","project_id":"..."}

# Or provide the service-account fields individually.
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=

# Optional fallback: point to a local service-account JSON file.
# FIREBASE_SERVICE_ACCOUNT_JSON=secrets/firebase-service-account.json

# ── Model weight paths (optional — defaults shown) ────────────────
EFFICIENTNET_IMAGE_MODEL_PATH=models/image_model.pth
XCEPTION_MODEL_PATH=models/best_xception_weights.h5
RESNET_MODEL_PATH=models/best_model_acc.keras
EFFICIENTNET_VIDEO_MODEL_PATH=models/video_model.pth

# ── Server ────────────────────────────────────────────────────────
PORT=8080
